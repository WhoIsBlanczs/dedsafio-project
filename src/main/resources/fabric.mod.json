{
  "schemaVersion": 1,
  "id": "ghostsafio",
  "version": "${version}",
  "name": "Hexagonsafio",
  "description": "Hexagonsafio (Ghostsafio) portado a Minecraft 26.3. Original de Nutria/\"Me!\", licencia CC0-1.0.",
  "authors": [
    "Me!"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/ghostsafio/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ghostsafio.mitomod.Ghostsafio"
    ],
    "client": [
      "com.ghostsafio.mitomod.client.GhostsafioClient"
    ]
  },
  "mixins": [
    "ghostsafio.mixins.json",
