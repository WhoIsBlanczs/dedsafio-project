  "subtitulos": [
    {
      "ini": 175.85,
      "fin": 179.45,
      "texto": "Un coloso alza su furia,"
    },
    {
      "ini": 179.45,
      "fin": 183.05,
      "texto": "con mil sombras tras de mí."
    },
    {
      "ini": 183.05,
      "fin": 186.85,
      "texto": "Más hay algo ahí en lo alto"
    },
    {
      "ini": 186.85,
      "fin": 189.65,
      "texto": "que hasta él teme descubrir."
    },
    {
      "ini": 189.65,
      "fin": 193.65,
      "texto": "Bajo su furia hay tristeza,"
    },
    {
      "ini": 193.65,
      "fin": 197.05,
      "texto": "bajo el trono hay un corazón."
    },
    {
      "ini": 197.05,
      "fin": 204.25,
      "texto": "Solo busca que comprendan lo que perdió su nación."
    },
    {
      "ini": 204.25,
      "fin": 211.25,
      "texto": "No desea más coronas, ni que lo llamen señor."
    },
    {
      "ini": 211.25,
      "fin": 220.45,
      "texto": "Solo quiere que no escuchen el silencio de su dolor."
    },
    {
      "ini": 220.45,
      "fin": 225.65,
      "texto": "Gira, gira, dulce azar,"
    },
    {
      "ini": 225.65,
      "fin": 231.25,
      "texto": "mil colores sobre el mar."
    },
    {
      "ini": 231.25,
      "fin": 236.65,
      "texto": "Ven conmigo, déjate llevar."
    },
    {
      "ini": 236.65,
      "fin": 243.35,
      "texto": "Gira, gira... y no mires atrás."
    },
    {
      "ini": 270.65,
      "fin": 274.25,
      "texto": "No le temas al gigante"
    },
    {
      "ini": 274.25,
      "fin": 277.65,
      "texto": "ni a su trono de dolor."
    },
    {
      "ini": 277.65,
      "fin": 281.65,
      "texto": "Hay un enjambre entre sombras"
    },
    {
      "ini": 281.65,
      "fin": 285.25,
      "texto": "que devora hasta el Sol."
    },
    {
      "ini": 285.25,
      "fin": 292.05,
      "texto": "Una mente entre lo alto, mil mundos quiere tener."
    },
    {
      "ini": 292.05,
      "fin": 300.65,
      "texto": "Y aquel rey de las tormentas, ante ellos solo es papel."
    },
    {
      "ini": 300.65,
      "fin": 305.85,
      "texto": "Gira, gira, dulce azar,"
    },
    {
      "ini": 305.85,
      "fin": 311.25,
      "texto": "mil colores sobre el mar."
    },
    {
      "ini": 311.25,
      "fin": 316.65,
      "texto": "Ven conmigo, déjate llevar."
    },
    {
      "ini": 316.65,
      "fin": 323.55,
      "texto": "Gira, gira... y no mires atrás."
    },
    {
      "ini": 350.25,
      "fin": 354.05,
      "texto": "Bajo aguas sin estrellas,"
    },
    {
      "ini": 354.05,
      "fin": 357.25,
      "texto": "donde nadie puede ver."
    },
    {
      "ini": 357.25,
      "fin": 361.45,
      "texto": "Luces púrpuras se mecen"
    },
    {
      "ini": 361.45,
      "fin": 364.85,
      "texto": "llamándote otra vez."
    },
    {
      "ini": 364.85,
      "fin": 371.85,
      "texto": "Si las sombras vienen juntas, juntos deben responder."
    },
    {
      "ini": 371.85,
      "fin": 380.95,
      "texto": "Lucha solo en aguas negras, no tendrás dónde volver."
    },
    {
      "ini": 383.05,
      "fin": 392.25,
      "texto": "Una mano salva a otra, una voz despierta al mar,"
    },
    {
      "ini": 392.25,
